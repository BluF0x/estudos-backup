formulas:
  Untitled: ""
views:
  - type: table
    name: Notas
    filters:
      and:
        - file.folder == "Notas"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - tags
      - fontes
      - file.backlinks
      - creation
    sort:
      - property: tags
        direction: ASC
    columnSize:
      file.name: 260
      note.fontes: 232
  - type: table
    name: Maps
    filters:
      and:
        - file.inFolder("Notas/Mapas")
